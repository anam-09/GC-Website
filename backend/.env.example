# Copy these values into your shell environment before starting Flask.
# Replace placeholders locally. Never commit real credentials.
FLASK_SECRET_KEY=replace-with-a-random-secret-before-running
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=grandcool
PGUSER=grandcool_app
PGPASSWORD=replace-with-your-local-database-password
# Optional alternative to PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD:
# DATABASE_URL=postgresql://grandcool_app:replace-me@127.0.0.1:5432/grandcool
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500